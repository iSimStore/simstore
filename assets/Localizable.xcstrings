{
  "sourceLanguage": "en",
  "strings": {
    "%@ and its data will be removed from %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ and its data will be removed from %2$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将从 %2$@ 中删除 %1$@ 及其数据。"
          }
        }
      }
    },
    "%@ couldn’t be opened. %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ couldn’t be opened. %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法打开 %@。%@"
          }
        }
      }
    },
    "%@ couldn’t be opened. Make sure the full Xcode application is installed and selected.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ couldn’t be opened. Make sure the full Xcode application is installed and selected."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法打开 %@。请确认已安装并选中完整的 Xcode 应用。"
          }
        }
      }
    },
    "%@ exited with status %d.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ exited with status %d."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已退出，退出码为 %d。"
          }
        }
      }
    },
    "%@ · %@": {
      "localizations": {
