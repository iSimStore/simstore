function(check_command expected)
    execute_process(COMMAND "${EXECUTABLE}" ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 10)
    if(NOT result STREQUAL "${expected}")
        message(FATAL_ERROR "Expected exit ${expected}, got ${result}: ${output}\n${error}")
    endif()
    set(command_output "${output}${error}" PARENT_SCOPE)
endfunction()

check_command(0 --list-tests)
if(NOT command_output STREQUAL "first\nfailure\nlast\n")
    message(FATAL_ERROR "Listing executed actions or omitted cases: ${command_output}")
endif()
check_command(0 --case last)
if(NOT command_output MATCHES "ran last" OR command_output MATCHES "ran first|expected failure")
    message(FATAL_ERROR "Case selection executed the wrong action: ${command_output}")
endif()
check_command(1 --case failure)
check_command(2 --case missing)
check_command(2 --case)
check_command(2 --unknown)
check_command(2 --list-tests extra)
check_command(1)
if(NOT command_output MATCHES "ran first" OR NOT command_output MATCHES "ran last" OR
   NOT command_output MATCHES "2 passed; 1 failed; 3 total")
    message(FATAL_ERROR "A failure stopped subsequent cases or reported success: ${command_output}")
endif()

file(MAKE_DIRECTORY "${WORK}")
file(WRITE "${WORK}/CTestTestfile.cmake" "include([==[${INCLUDE_FILE}]==])\n")
execute_process(COMMAND "${CTEST_EXECUTABLE}" --test-dir "${WORK}"
    --output-on-failure --output-junit "${WORK}/results.xml"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 20)
if(NOT result STREQUAL "8")
    message(FATAL_ERROR "Expected one failing CTest case: ${result}\n${output}\n${error}")
endif()
file(READ "${WORK}/results.xml" report)
string(REGEX MATCHALL "<testcase " cases "${report}")
list(LENGTH cases count)
string(REGEX MATCHALL "<failure" failures "${report}")
list(LENGTH failures failed)
if(NOT count EQUAL 3 OR NOT failed EQUAL 1 OR NOT report MATCHES "runner-fixture.last")
    message(FATAL_ERROR "CTest/JUnit did not report each case independently: ${report}")
endif()

execute_process(COMMAND "${CTEST_EXECUTABLE}" --test-dir "${WORK}" --show-only=json-v1
    RESULT_VARIABLE result OUTPUT_VARIABLE metadata ERROR_VARIABLE error TIMEOUT 10)
if(NOT result STREQUAL "0")
    message(FATAL_ERROR "Could not read discovered test metadata: ${error}")
endif()
string(JSON count LENGTH "${metadata}" tests)
if(NOT count EQUAL 3)
    message(FATAL_ERROR "Expected three independently selectable cases")
endif()
string(JSON count LENGTH "${metadata}" tests 0 properties)
math(EXPR last "${count} - 1")
set(checked)
foreach(index RANGE ${last})
    string(JSON name GET "${metadata}" tests 0 properties ${index} name)
    if(name STREQUAL "TIMEOUT")
        string(JSON value GET "${metadata}" tests 0 properties ${index} value)
        if(NOT value EQUAL 5)
            message(FATAL_ERROR "Lost the suite's per-case timeout")
        endif()
        list(APPEND checked TIMEOUT)
    elseif(name STREQUAL "RUN_SERIAL")
        string(JSON value GET "${metadata}" tests 0 properties ${index} value)
        if(NOT value)
            message(FATAL_ERROR "Lost the suite's serial execution setting")
        endif()
        list(APPEND checked RUN_SERIAL)
    elseif(name STREQUAL "LABELS")
        string(JSON value GET "${metadata}" tests 0 properties ${index} value 0)
        if(NOT value STREQUAL "runner-fixture")
            message(FATAL_ERROR "Lost the suite's selection label")
        endif()
        list(APPEND checked LABELS)
    endif()
endforeach()
list(LENGTH checked count)
if(NOT count EQUAL 3)
    message(FATAL_ERROR "Missing discovered case properties: ${checked}")
endif()

# Missing discovery markers must fail without executing an older, incompatible binary.
file(WRITE "${WORK}/CTestTestfile.cmake"
    "set(SWIFT_TEST_CMAKE_COMMAND [==[${CMAKE_COMMAND}]==])\n"
    "include([==[${DISCOVERY_SCRIPT}]==])\n"
    "discover_swift_tests([==[${EXECUTABLE}]==] [==[${WORK}/missing-marker]==] unbuilt-fixture 5 TRUE [==[${WORK}]==])\n")
execute_process(COMMAND "${CTEST_EXECUTABLE}" --test-dir "${WORK}"
    --output-junit "${WORK}/unbuilt.xml"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 10)
file(READ "${WORK}/unbuilt.xml" report)
if(NOT result STREQUAL "8" OR NOT report MATCHES "unbuilt-fixture.not-built")
    message(FATAL_ERROR "An unbuilt suite must fail explicitly: ${output}\n${error}\n${report}")
endif()
